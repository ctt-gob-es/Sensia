# AUTH

# generate-dev-env.sh genera uno aleatorio
AUTH_TOKEN=6a9c1f23c9CHANGEIT213f1c4e9b7d65u
AUTH_CERT_WHITELIST=

# SSL / mTLS

JETTY_SSL_KEYSTORE_PATH=local-env/keystore.p12
JETTY_SSL_KEYSTORE_PASSWORD=

JETTY_SSL_TRUSTSTORE_PATH=local-env/truststore.p12
JETTY_SSL_TRUSTSTORE_PASSWORD=

JETTY_SSL_REQUIRECLIENTAUTH=false
JETTY_SSL_VALIDATEPEERCERTS=false
JETTY_SSL_ENABLECRLDP=false
JETTY_SSL_ENABLEOCSP=false


# SERVIDOR JETTY


JETTY_HTTP_ENABLED=true
JETTY_HTTPS_ENABLED=true
JETTY_SSL_ENABLED=false
REQUIRE_MTLS=false
JETTY_HTTP_PORT=7070
JETTY_HTTPS_PORT=7443
JETTY_SSL_PORT=7444

# Tamaño máximo de la petición POST en bytes
JETTY_HTTP_MAXPOSTSIZE=73400320

# THREAD POOL
# Máximo de hilos concurrentes en todo el servidor
JETTY_THREADPOOL_MAXTHREADS=200

# Hilos mínimos siempre vivos esperando peticiones
JETTY_THREADPOOL_MINTHREADS=10

# Tiempo en milisegundos para destruir hilos inactivos
JETTY_THREADPOOL_IDLETIMEOUTMS=60000

# CONNECTOR
# Tiempo en milisegundos para cerrar conexiones HTTP sin actividad
JETTY_CONNECTOR_IDLETIMEOUTMS=30000



# QoS
# Máximo de peticiones SOAP procesándose al mismo tiempo
JETTY_QOS_MAXREQUESTS=50

# Tiempo máximo en milisegundos que una petición esperará en cola
JETTY_QOS_SUSPENDMS=5000

# Logs datos sensibles. DESACTIVADO SIEMPRE EN PRODUCCIÓN
SENSIA_LOG_SENSIBLE=DEBUG
SENSIA_LOG_SENSIBLE_DIR=logs-sensibles

# Observabilidad y OpenTelemetry
OTEL_SDK_DISABLED=false
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

GRPC_TLS_ENABLED=false