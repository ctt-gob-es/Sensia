<?xml version="1.0" encoding="UTF-8"?>
<configuration> <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%level] [TraceID: %X{trace_id}] [%thread] %logger{36} %X{ticketId} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-./logs}/app.log</file> 
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%level] [TraceID: %X{trace_id}] [%thread] %logger{36} %X{ticketId} - %msg%n</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-./logs}/app-%d{yyyy-MM-dd}-%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>10</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

     <appender name="SENSIBLE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${SENSIA_LOG_SENSIBLE_DIR:-/opt/sensia/logs-sensibles}/sensible.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${SENSIA_LOG_SENSIBLE_DIR:-/opt/sensia/logs-sensibles}/sensible.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>2</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%-5level] [TraceID: %X{trace_id}] [%thread] %logger{36} %X{ticketId} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.eclipse.jetty" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <logger name="io.github.sensia" level="${SENSIA_LOG_LEVEL:-INFO}" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <logger name="org.eclipse.jetty.server.RequestLog" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <logger name="org.eclipse.jetty.server.HttpConnection" level="INFO" />
    <logger name="org.eclipse.jetty.io.ssl.SslConnection" level="INFO" />

    <logger name="sensia.sensible" level="${SENSIA_LOG_SENSIBLE:-OFF}" additivity="false">
        <appender-ref ref="SENSIBLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>