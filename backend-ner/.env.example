ENV=development
LOG_LEVEL=INFO

GRPC_BIND_TYPE=TCP
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_SOCKET_PATH=/tmp/roberta-ner.sock

MODEL_PATH=models/roberta_bsc.onnx
TOKENIZER_PATH=models/tokenizer
NER_MERGE_ORG_LOC=true
NER_AGGREGATION=first
ONNX_EXECUTION_PROVIDER=CPUExecutionProvider

ENFORCE_SECURITY=false
# mTLS: solo con ENFORCE_SECURITY=true y ENV=production (vacío = sin configurar)
TLS_CA_FILE=
TLS_CERT_FILE=
TLS_KEY_FILE=
# OpenTelemetry
OTEL_SDK_DISABLED=false

HF_HUB_OFFLINE=1 
TRANSFORMERS_OFFLINE=1
