{
  "name": "sensia-app",
  "version": "1.0.0-rc.1",
  "scripts": {
    "ng": "ng",
    "start": "cp public/env.development.json public/env.json && ng serve",
    "build": "cp public/env.production.json public/env.json && npx ng build",
    "watch": "cp public/env.development.json public/env.json && ng build --watch --configuration development",
    "clean": "rm -rf ./node_modules ./dist ./.angular"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.11",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.11",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "^21.2.25",
    "@fontsource/roboto": "^5.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-fetch": "^0.222.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.222.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "altcha": "^2.3.0",
    "ng2-pdf-viewer": "^10.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xml2js": "^0.6.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "@types/xml2js": "^0.4.14",
    "typescript": "~5.9.2"
  }
}
