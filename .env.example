# =============================================================================
# SensIA - valores por defecto del asistente (env.sh)
#
# env.sh parte de estos valores, los ofrece como sugerencia en cada pregunta
#
# - Los secretos y valores calculados se ignoran aunque se rellenen aquí.
# - Un valor vacío significa "usar el valor por defecto del asistente".
# - No pongas comentarios al final de una línea con valor.
# =============================================================================

# Dominio y proxy
DOMAIN_NAME=sensia.tuorganismo.es
CERT_FILE=
KEY_FILE=
PORT_PROXY_HTTP=80
PORT_PROXY_HTTPS=443

# Certificados (los genera env.sh)
CERTS_GID=
KEYSTORE_PASSWORD=
TRUSTSTORE_PASSWORD=

# SOAP y mTLS
SOAP_API_TOKEN=
REQUIRE_MTLS=false
AUTH_CERT_WHITELIST=
PORT_WS_MTLS=8443

# Servicio NER
# En el despliegue debe ser production: development desactiva el mTLS del NER, y backend-ws lo exige siempre con ENFORCE_SECURITY=true.
ENV=production
LOG_LEVEL=INFO
ENFORCE_SECURITY=true

# Aplicación
# Los genera env.sh
JWT_SECRET=
ALTCHA_HMAC_KEY=
# Vacío = admin@<dominio>
DEFAULT_ADMIN_USER=
# La genera env.sh
DEFAULT_ADMIN_PASSWORD=
HARD_MAINTENANCE=false

# Correo
# Opciones: PLAIN, OAUTH2, NONE (relay del organismo) o vacío (sin correo)
SMTP_AUTH_METHOD=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=
# Ej. proveedores
#   Google:        OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
#   Microsoft 365: OAUTH_TOKEN_URL=https://login.microsoftonline.com/<id-del-tenant>/oauth2/v2.0/token
OAUTH_TOKEN_URL=
# Opcional. Ej. valores: openid email profile
OAUTH_SCOPE=

# Observabilidad
# "obs" = respuesta por defecto Sí a "¿Activar la observabilidad?"
COMPOSE_PROFILES=

# Los fija env.sh según se active o no la observabilidad
ENABLE_TRACING=false
OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=none

# La genera env.sh
GRAFANA_PASSWORD=
